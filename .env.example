# mizan — example environment file.
#
# Copy to `.env` for local use. `.env` and every `.env.*` except this file are
# gitignored, and gate G-4 (gitleaks) fails the build if a secret is ever tracked.
#
# Every value below is a PLACEHOLDER. mizan ships with no credentials, and it
# runs with none: with no provider configured the CLI prints the honest
# degradation "model unavailable" rather than falling back to a mock.

# ── Inference provider ────────────────────────────────────────────────────────
# hosted | local | scripted
#   hosted   = OpenAI-compatible /chat/completions endpoint (ADR-04 demo default)
#   local    = Ollama at MIZAN_LOCAL_URL (documented offline mode)
#   scripted = committed deterministic answer catalogue, labelled
#              "precomputed (deterministic)" in the trace and on stdout
MIZAN_PROVIDER=hosted
MIZAN_LLM_BASE_URL=https://api.example-provider.invalid/v1
MIZAN_LLM_MODEL=replace-me
# Read from the process environment or your OS key store. Never commit a value.
MIZAN_LLM_API_KEY=

# ── Local inference (offline mode) ────────────────────────────────────────────
MIZAN_LOCAL_URL=http://127.0.0.1:11434
MIZAN_LOCAL_MODEL=replace-me

# ── Tafsir (thin client) ──────────────────────────────────────────────────────
# Empty disables the tool and reports "unavailable" honestly. When set, the host
# MUST appear in ALLOWED_TAFSIR_HOSTS in packages/mizan-retrieval/src/allowlist.ts
# or the call is refused with allowlist_denied (R13 / A10).
MIZAN_TAFSIR_URL=

# ── Corpus ────────────────────────────────────────────────────────────────────
# Leave empty to use the repo-relative defaults.
MIZAN_CORPUS_DB=
MIZAN_CORPUS_ATTESTATION=
