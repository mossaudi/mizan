{
  "name": "mizan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "مizan (ميزان) - per-claim citation verification for Qur'an and hadith answers. Islamic AI Challenge, Track 4.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "ci": "bun run scripts/ci.ts",
    "typecheck": "bun run scripts/ci.ts --only=typecheck",
    "ci:typecheck": "bun run typecheck",
    "ci:test": "bun run scripts/ci.ts --only=test",
    "ci:gates": "bun run scripts/ci.ts --only=gates",
    "test": "bun run scripts/root-test-refuses.ts",
    "ingest": "bun run scripts/ingest.ts",
    "ingest:check": "bun run scripts/ingest.ts --check",
    "build:eval": "bun run scripts/build-eval-set.ts",
    "make:transcript": "bun run apps/cli/scripts/make-transcript.ts",
    "build:web": "bun run apps/web/scripts/build-page.ts",
    "ask": "bun run apps/cli/src/main.ts",
    "demo": "bun run apps/cli/src/demo.ts",
    "benchmark:vs-search": "bun run scripts/benchmark/run.ts",
    "verify:ledger": "bun run scripts/verify-ledger.ts",
    "verify:runs": "bun run scripts/verify-runs.ts",
    "check:docs": "bun run scripts/check-docs-claims.ts"
  },
  "dependencies": {
    "@mizan/core": "workspace:*",
    "@mizan/corpus": "workspace:*",
    "@mizan/gate": "workspace:*",
    "@mizan/provenance": "workspace:*",
    "@mizan/verify": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.6.3"
  },
  "engines": {
    "bun": "1.3.14"
  }
}
